# =====================================================================
# VARIABLES DE ENTORNO — Conexión a MySQL
# ---------------------------------------------------------------------
# Copia este archivo como ".env" y ajusta los valores según tu entorno
# local. El backend lee estas variables en src/db/connection.js.
# =====================================================================

# Host del servidor MySQL
DB_HOST=localhost

# Puerto de MySQL (3306 por defecto)
DB_PORT=3306

# Usuario de MySQL
DB_USER=root

# Contraseña del usuario de MySQL
DB_PASSWORD=

# Nombre de la base de datos
DB_NAME=jobtracker

# Tamaño máximo del pool de conexiones (opcional)
DB_CONNECTION_LIMIT=10

# Puerto en el que corre el servidor Express
PORT=3000
